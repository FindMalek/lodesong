{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "ignoreFiles": ["integrations/**"],
  "ignoreIssues": {
    "apps/player/src/components/ui/**": ["exports", "types"],
    "apps/video/src/captures/types.ts": ["types"],
    "packages/ui/src/components/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "test/output-tap.js"]
    },
    "apps/player": {
      "entry": ["src/main.tsx", "src/app.css"]
    },
    "apps/video": {
      "entry": ["src/index.ts", "remotion.config.ts", "scripts/perf-player.ts"]
    },
    "apps/web": {
      "ignoreDependencies": ["collections"]
    }
  }
}
