{
  "name": "@lodesong/video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "audio": "cd ../.. && bun scripts/video-audio.ts",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts open out/open.mp4 --codec=h264 --crf=16",
    "render:gif": "remotion render src/index.ts open out/open.gif --every-nth-frame=3 --scale=0.5",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/tailwind-v4": "4.0.541",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.541",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@lodesong/config": "workspace:*",
    "@lodesong/shared": "workspace:*",
    "@lodesong/ui": "workspace:*",
    "@types/react": "19.3.0"
  }
}
